rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USER PROFILE RULES ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      
      // Create rules validation
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['week', 'updatedAt'])
        && request.resource.data.week is int
        && request.resource.data.week >= 1
        && request.resource.data.week <= 40
        && request.resource.data.updatedAt == request.time;
      
      // Update rules validation 
      allow update: if isOwner(userId)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      // --- JOURNAL ENTRIES RULES ---
      match /entries/{entryId} {
        allow list, get: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidId(entryId)
          && request.resource.data.keys().hasAll(['id', 'date', 'mood', 'emoji', 'text', 'symptoms', 'week', 'createdAt'])
          && request.resource.data.id is string
          && request.resource.data.id.size() <= 128
          && request.resource.data.week is int
          && request.resource.data.week >= 1
          && request.resource.data.week <= 40
          && request.resource.data.mood is string
          && request.resource.data.mood.size() <= 100
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 10000
          && request.resource.data.symptoms is list
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner(userId)
          && isValidId(entryId)
          && request.resource.data.createdAt == resource.data.createdAt; // creation time is immutable

        allow delete: if isOwner(userId);
      }

      // --- PRENATAL APPOINTMENTS RULES ---
      match /appointments/{apptId} {
        allow list, get: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(apptId)
          && request.resource.data.keys().hasAll(['id', 'title', 'date', 'done', 'createdAt'])
          && request.resource.data.id is string
          && request.resource.data.id.size() <= 128
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.date is string
          && request.resource.data.date.size() <= 30
          && request.resource.data.done is bool
          && request.resource.data.createdAt == request.time;

        allow update: if isOwner(userId)
          && isValidId(apptId)
          && request.resource.data.createdAt == resource.data.createdAt; // creation time is immutable

        allow delete: if isOwner(userId);
      }
    }
  }
}
